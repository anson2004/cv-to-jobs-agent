GROQ_API_KEY=gsk_...

# optional: email delivery (without these the email is written to data/out/<run_id>.html)
# RESEND_API_KEY=re_...
# TO_EMAIL=you@example.com

# optional: any OpenAI-compatible backend
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# MODEL_STRONG=openai/gpt-oss-120b
# MODEL_FAST=qwen/qwen3.8-27b
# SCORE_CONCURRENCY=2
# MAX_JOBS_TO_SCORE=40

# optional: location filter and the opt-in Finnish source (see README: Duunitori caveat)
# LOCATION=Tampere
# DUUNITORI_ENABLED=true

# optional: local LLM in Docker (docker compose up -d ollama; docker compose run --rm pull)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# MODEL_STRONG=qwen3:8b
# MODEL_FAST=qwen3:8b
# REASONING_EFFORT=none
# LLM_TIMEOUT_S=300
# SCORE_CONCURRENCY=1
