<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>{{ items|length }} jobs for {{ profile.name }}</title>
<style>
  body { font-family: -apple-system, Segoe UI, Helvetica, Arial, sans-serif; color: #1a1a1a; background: #f6f6f4; margin: 0; padding: 24px; }
  .wrap { max-width: 640px; margin: 0 auto; }
  h1 { font-size: 20px; margin: 0 0 4px; }
  .sub { color: #666; font-size: 13px; margin-bottom: 20px; }
  .card { background: #fff; border: 1px solid #e3e3df; border-radius: 10px; padding: 16px 18px; margin-bottom: 14px; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .title { font-size: 16px; font-weight: 600; }
  .meta { color: #666; font-size: 13px; margin-top: 2px; }
  .score { font-variant-numeric: tabular-nums; font-weight: 700; color: #0b6b3a; white-space: nowrap; }
  .pitch { margin: 10px 0 8px; font-size: 14px; }
  h4 { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: #888; margin: 10px 0 4px; }
  ul { margin: 0; padding-left: 18px; font-size: 13.5px; }
  li { margin: 2px 0; }
  .flags { color: #9a3b00; }
  a.btn { display: inline-block; margin-top: 10px; font-size: 13px; color: #0b57d0; text-decoration: none; }
  .foot { color: #999; font-size: 11px; margin-top: 18px; }
  .dims { color: #666; font-size: 12px; }
</style>
</head>
<body>
<div class="wrap">
  <h1>{{ items|length }} jobs worth a look, {{ profile.name.split()[0] }}</h1>
  <div class="sub">Matched against: {{ profile.headline }}</div>

  {% for it in items %}
  <div class="card">
    <div class="head">
      <div>
        <div class="title">{{ it.job.title }}</div>
        <div class="meta">{{ it.job.company }} · {{ it.job.location }}{% if it.job.remote %} · remote{% endif %}{% if it.job.salary %} · {{ it.job.salary }}{% endif %}</div>
      </div>
      <div class="score">{{ "%.1f"|format(it.score.overall) }}/5</div>
    </div>
    <div class="dims">skills {{ it.score.skill_fit }} · level {{ it.score.seniority_fit }} · location {{ it.score.location_fit }} · growth {{ it.score.growth }}</div>
    <div class="pitch">{{ it.rec.one_line_pitch }}</div>
    <h4>Why you</h4>
    <ul>{% for b in it.rec.why_you %}<li>{{ b }}</li>{% endfor %}</ul>
    <h4>What to address</h4>
    <ul>{% for b in it.rec.what_to_address %}<li>{{ b }}</li>{% endfor %}</ul>
    {% if it.score.red_flags %}
    <h4>Red flags</h4>
    <ul class="flags">{% for b in it.score.red_flags %}<li>{{ b }}</li>{% endfor %}</ul>
    {% endif %}
    <a class="btn" href="{{ it.job.url }}">View posting →</a>
  </div>
  {% endfor %}

  <div class="foot">run {{ run_id }} · generated by job-ad-orchestrator · scores are model estimates, read the posting</div>
</div>
</body>
</html>
